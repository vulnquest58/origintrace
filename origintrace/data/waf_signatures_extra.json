{
  "metadata": {
    "version": "1.1.0",
    "description": "Supplementary WAF signatures layered on top of the ported dataset. The ported file matches header *names*; vendors very often announce themselves in the value of `server`, `via` or a custom header instead, which is why these live in a separate overlay rather than editing the original.",
    "matching": "header names, header name+value pairs, cookies, body markers",
    "added": "2026-10-31"
  },

  "fastly": {
    "name": "Fastly",
    "vendor": "Fastly, Inc.",
    "type": "cdn",
    "headers": ["x-fastly-request-id", "x-fastly-ssl", "fastly-ssl"],
    "header_values": [
      {"name": "server", "pattern": "fastly"},
      {"name": "via", "pattern": "varnish"},
      {"name": "x-served-by", "pattern": "cache-"}
    ],
    "cookies": ["_fastly"],
    "body_signatures": ["Fastly error: unknown domain", "Varnish cache server"]
  },

  "fortinet_fortiweb": {
    "name": "FortiWeb",
    "vendor": "Fortinet",
    "header_values": [
      {"name": "server", "pattern": "fortiweb"},
      {"name": "server", "pattern": "forti"},
      {"name": "set-cookie", "pattern": "fortiwafsid"}
    ],
    "body_signatures": ["FortiWeb", "The requested URL was rejected. Please consult with your administrator"]
  },

  "citrix_netscaler": {
    "name": "Citrix NetScaler / ADC",
    "vendor": "Citrix",
    "header_values": [
      {"name": "server", "pattern": "netscaler"},
      {"name": "via", "pattern": "ns-cache"},
      {"name": "set-cookie", "pattern": "citrix_ns_id"}
    ],
    "body_signatures": ["NetScaler", "Citrix ADC"],
    "response_codes": [403, 503]
  },

  "wallarm": {
    "name": "Wallarm",
    "vendor": "Wallarm",
    "header_values": [
      {"name": "server", "pattern": "wallarm"},
      {"name": "x-wallarm-waf-check", "pattern": ""}
    ],
    "body_signatures": ["wallarm", "Request blocked by Wallarm"]
  },

  "wordfence": {
    "name": "Wordfence",
    "vendor": "Defiant",
    "header_values": [
      {"name": "server", "pattern": "wordfence"},
      {"name": "set-cookie", "pattern": "wfvt_"},
      {"name": "x-wf-block", "pattern": ""}
    ],
    "body_signatures": ["Generated by Wordfence", "Your access to this site has been limited by the site owner"]
  },

  "radware_appwall": {
